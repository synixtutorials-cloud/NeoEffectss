{"neofx":2,"id":"fractal_noise","name":"Fractal Noise","category":"Stylize","params":[{"id":"scale","name":"Scale","min":1,"max":30,"default":8},{"id":"amount","name":"Amount","min":0,"max":1,"default":0.4},{"id":"rate","name":"Speed","min":0,"max":5,"default":0.5}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } float vn(vec2 p) { vec2 i = floor(p); vec2 f = fract(p); f = f * f * (3.0 - 2.0 * f); float a = rnd(i); float b = rnd(i + vec2(1.0, 0.0)); float c = rnd(i + vec2(0.0, 1.0)); float d = rnd(i + vec2(1.0, 1.0)); return mix(mix(a, b, f.x), mix(c, d, f.x), f.y); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float n = 0.0; float a = 0.5; vec2 p = uv * scale + vec2(time * rate, time * rate * 0.6); for (int i = 0; i < 5; i++) { n += a * vn(p); p *= 2.0; a *= 0.5; } return vec4(mix(c.rgb, c.rgb * (0.4 + n * 1.2), amount), c.a); }"}
