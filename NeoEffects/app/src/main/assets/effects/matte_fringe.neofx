{"neofx":2,"id":"matte_fringe","name":"Matte Fringe","category":"Key","params":[{"id":"width","name":"Width","min":0.5,"max":10,"default":2},{"id":"hue","name":"Hue","min":0,"max":1,"default":0.0},{"id":"amount","name":"Amount","min":0,"max":2,"default":1}],"shader":"vec3 rgb2hsv(vec3 c) { vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0); vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g)); vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r)); float d = q.x - min(q.w, q.y); float e = 1.0e-10; return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x); } vec3 hsv2rgb(vec3 c) { vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0); vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www); return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec2 px = width / resolution; float b = (texture2D(image, uv + vec2(px.x, 0.0)).a + texture2D(image, uv - vec2(px.x, 0.0)).a + texture2D(image, uv + vec2(0.0, px.y)).a + texture2D(image, uv - vec2(0.0, px.y)).a) / 4.0; float e = clamp(abs(b - c.a) * 3.0, 0.0, 1.0); return vec4(c.rgb + hsv2rgb(vec3(hue, 0.8, 1.0)) * e * amount * c.a, c.a); }"}
