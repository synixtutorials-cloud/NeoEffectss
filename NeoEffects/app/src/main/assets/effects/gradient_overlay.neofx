{"neofx":2,"id":"gradient_overlay","name":"Gradient Overlay","category":"Color","params":[{"id":"angle","name":"Angle","min":0,"max":360,"default":90},{"id":"h1","name":"Start hue","min":0,"max":1,"default":0.95},{"id":"h2","name":"End hue","min":0,"max":1,"default":0.6},{"id":"amount","name":"Amount","min":0,"max":1,"default":0.5}],"shader":"vec3 rgb2hsv(vec3 c) { vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0); vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g)); vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r)); float d = q.x - min(q.w, q.y); float e = 1.0e-10; return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x); } vec3 hsv2rgb(vec3 c) { vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0); vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www); return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y); } vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); float a = radians(angle); float t = clamp(dot(uv - vec2(0.5, 0.5), vec2(cos(a), sin(a))) + 0.5, 0.0, 1.0); vec3 g = mix(hsv2rgb(vec3(h1, 0.85, 1.0)), hsv2rgb(vec3(h2, 0.85, 1.0)), t); return vec4(mix(s.rgb, vec3(1.0) - (vec3(1.0) - s.rgb) * (vec3(1.0) - g), amount), s.a); }"}
