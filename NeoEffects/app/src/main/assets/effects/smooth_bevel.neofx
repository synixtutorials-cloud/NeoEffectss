{"neofx":2,"id":"smooth_bevel","name":"Smooth Bevel","category":"Stylize","params":[{"id":"depth","name":"Depth","min":0,"max":6,"default":2},{"id":"angle","name":"Angle","min":0,"max":360,"default":135}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec4 effect(vec2 uv) { float a = radians(angle); vec2 o = vec2(cos(a), sin(a)) / resolution * 2.0; float d = lum(texture2D(image, uv + o).rgb) - lum(texture2D(image, uv - o).rgb); vec4 c = texture2D(image, uv); return vec4(clamp(c.rgb + vec3(d * depth), 0.0, 1.0), c.a); }"}
