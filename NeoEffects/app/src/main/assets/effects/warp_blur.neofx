{"neofx":2,"id":"warp_blur","name":"Warp Blur","category":"Blur","params":[{"id":"radius","name":"Radius","min":0,"max":60,"default":16},{"id":"scale","name":"Scale","min":1,"max":20,"default":6}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } float vn(vec2 p) { vec2 i = floor(p); vec2 f = fract(p); f = f * f * (3.0 - 2.0 * f); float a = rnd(i); float b = rnd(i + vec2(1.0, 0.0)); float c = rnd(i + vec2(0.0, 1.0)); float d = rnd(i + vec2(1.0, 1.0)); return mix(mix(a, b, f.x), mix(c, d, f.x), f.y); } vec4 effect(vec2 uv) { float a = vn(uv * scale + time * 0.2) * 6.2831853; vec2 d = vec2(cos(a), sin(a)) * radius / resolution; vec4 s = vec4(0.0); for (int i = 0; i < 8; i++) { s += texture2D(image, uv + d * (float(i) / 7.0 - 0.5)); } return s / 8.0; }"}
