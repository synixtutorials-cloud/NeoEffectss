{"neofx":2,"id":"dark_glow","name":"Dark Glow","category":"Light","params":[{"id":"radius","name":"Radius","min":1,"max":60,"default":20},{"id":"intensity","name":"Intensity","min":0,"max":3,"default":1},{"id":"threshold","name":"Threshold","min":0,"max":1,"default":0.5}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec2 px = radius / resolution; float g = 0.0; for (int i = 0; i < 12; i++) { float a = float(i) * 0.5236; vec2 d = vec2(cos(a), sin(a)); g += max(threshold - dot(texture2D(image, uv + d * px).rgb, vec3(0.333)), 0.0); g += max(threshold - dot(texture2D(image, uv + d * px * 0.5).rgb, vec3(0.333)), 0.0); } g /= 24.0; return vec4(c.rgb * (1.0 - clamp(g * intensity * 3.0, 0.0, 1.0)), c.a); }"}
