{"neofx":2,"id":"noise_rgb","name":"Add Noise","category":"Stylize","params":[{"id":"amount","name":"Amount","min":0,"max":1,"default":0.2},{"id":"colored","name":"Colour","min":0,"max":1,"default":1}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec2 p = uv * resolution + floor(time * 24.0) * 11.0; vec3 n = vec3(rnd(p), rnd(p + vec2(3.1, 1.7)), rnd(p + vec2(5.3, 9.1))); n = mix(vec3(n.r), n, colored); return vec4(clamp(c.rgb + (n - vec3(0.5)) * amount, 0.0, 1.0), c.a); }"}
