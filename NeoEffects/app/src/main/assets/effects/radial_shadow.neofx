{"neofx":2,"id":"radial_shadow","name":"Radial Shadow","category":"Light","params":[{"id":"strength","name":"Strength","min":0,"max":1,"default":0.6},{"id":"dist","name":"Length","min":0,"max":1,"default":0.4}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec2 d = (vec2(0.5, 0.5) - uv) * dist; float sh = 0.0; for (int i = 1; i <= 10; i++) { sh = max(sh, lum(texture2D(image, uv + d * float(i) / 10.0).rgb)); } float m = sh * (1.0 - lum(c.rgb)); return vec4(c.rgb * (1.0 - m * strength), c.a); }"}
