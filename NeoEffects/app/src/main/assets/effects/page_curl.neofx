{"neofx":2,"id":"page_curl","name":"Page Curl","category":"Distort","params":[{"id":"curl","name":"Curl","min":0,"max":1,"default":0.4},{"id":"angle","name":"Angle","min":0,"max":360,"default":0}],"shader":"vec4 effect(vec2 uv) { float a = radians(angle); vec2 dir = vec2(cos(a), sin(a)); float p = dot(uv - vec2(0.5, 0.5), dir) + 0.5; float f = 1.0 - curl; if (p > f) { float d = p - f; if (d > curl) { return vec4(0.0); } vec2 r = uv - dir * (2.0 * d); vec4 b = texture2D(image, r); float inside = step(0.0, r.x) * step(r.x, 1.0) * step(0.0, r.y) * step(r.y, 1.0); float sh = 1.0 - d * 0.8; return vec4(b.rgb * 0.75 * sh * inside, inside * b.a); } return texture2D(image, uv); }"}
