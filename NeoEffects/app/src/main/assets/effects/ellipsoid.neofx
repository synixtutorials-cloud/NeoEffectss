{"neofx":2,"id":"ellipsoid","name":"Ellipsoid","category":"Distort","params":[{"id":"amount","name":"Amount","min":-1,"max":1,"default":0.8},{"id":"rx","name":"Width","min":0.2,"max":1,"default":0.6},{"id":"ry","name":"Height","min":0.2,"max":1,"default":0.4}],"shader":"vec4 effect(vec2 uv) { vec2 d = (uv - vec2(0.5, 0.5)) / vec2(rx, ry); float nr = length(d); if (nr < 1.0) { float f = (1.0 - sqrt(1.0 - nr * nr)) / max(nr, 0.0001); d *= mix(1.0, f, amount); } return texture2D(image, vec2(0.5, 0.5) + d * vec2(rx, ry)); }"}
