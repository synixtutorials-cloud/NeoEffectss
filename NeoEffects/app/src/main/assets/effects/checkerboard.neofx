{"neofx":2,"id":"checkerboard","name":"Checkerboard","category":"Stylize","params":[{"id":"tile","name":"Tile size","min":8,"max":300,"default":40},{"id":"opacity","name":"Opacity","min":0,"max":1,"default":0.4}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec2 p = uv * resolution; float k = mod(floor(p.x / tile) + floor(p.y / tile), 2.0); return vec4(mix(c.rgb, vec3(k), opacity), c.a); }"}
