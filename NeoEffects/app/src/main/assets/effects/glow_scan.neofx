{"neofx":2,"id":"glow_scan","name":"Glow Scan","category":"Light","params":[{"id":"rate","name":"Speed","min":0,"max":5,"default":1},{"id":"width","name":"Width","min":0.02,"max":0.5,"default":0.12},{"id":"intensity","name":"Intensity","min":0,"max":3,"default":1},{"id":"angle","name":"Angle","min":0,"max":360,"default":90}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float a = radians(angle); float p = dot(uv - vec2(0.5, 0.5), vec2(cos(a), sin(a))) + 0.5; float pos = fract(time * rate * 0.3) * 1.4 - 0.2; float g = exp(-pow((p - pos) / width, 2.0)); return vec4(c.rgb + vec3(g * intensity * 0.6) * (0.4 + c.rgb), c.a); }"}
