{"neofx":2,"id":"stroke_colour","name":"Stroke Colour","category":"Stylize","params":[{"id":"width","name":"Width","min":1,"max":40,"default":6},{"id":"hue","name":"Hue","min":0,"max":1,"default":0},{"id":"bright","name":"Brightness","min":0,"max":1,"default":1},{"id":"sat","name":"Saturation","min":0,"max":1,"default":0}],"shader":"vec3 rgb2hsv(vec3 c) { vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0); vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g)); vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r)); float d = q.x - min(q.w, q.y); float e = 1.0e-10; return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x); } vec3 hsv2rgb(vec3 c) { vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0); vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www); return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float m = c.a; vec2 px = width / resolution; for (int i = 0; i < 12; i++) { float a = float(i) * 0.5236; m = max(m, texture2D(image, uv + vec2(cos(a), sin(a)) * px).a); } float s = m - c.a; vec3 col = hsv2rgb(vec3(hue, sat, bright)); return vec4(c.rgb + col * s, c.a + s); }"}
