{"neofx":2,"id":"zoom_streaks","name":"Zoom Streaks","category":"Blur","params":[{"id":"strength","name":"Length","min":0,"max":1,"default":0.4},{"id":"threshold","name":"Threshold","min":0,"max":1,"default":0.5},{"id":"gain","name":"Gain","min":0,"max":2,"default":1}],"shader":"vec4 effect(vec2 uv) { vec2 d = (uv - vec2(0.5, 0.5)) * strength; vec4 c = texture2D(image, uv); vec3 m = vec3(0.0); for (int i = 1; i <= 10; i++) { vec3 s = texture2D(image, uv - d * float(i) / 10.0).rgb; m = max(m, max(s - vec3(threshold), vec3(0.0)) * (1.0 - float(i) / 11.0)); } return vec4(c.rgb + m * gain, c.a); }"}
