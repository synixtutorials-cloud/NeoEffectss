{"neofx":2,"id":"block_dissolve","name":"Block Dissolve","category":"Animate","params":[{"id":"dur","name":"Duration (s)","min":0.1,"max":5,"default":1},{"id":"block","name":"Block size","min":4,"max":200,"default":40},{"id":"reverse","name":"Dissolve in","min":0,"max":1,"default":0}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float p = clamp(ctime / dur, 0.0, 1.0); float r = rnd(floor(uv * resolution / block)); float m = reverse > 0.5 ? step(1.0 - p, r) : step(p, r); return c * (reverse > 0.5 ? 1.0 - m : m); }"}
