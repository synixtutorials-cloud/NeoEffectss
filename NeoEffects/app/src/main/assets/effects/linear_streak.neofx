{"neofx":2,"id":"linear_streak","name":"Linear Streak","category":"Blur","params":[{"id":"angle","name":"Angle","min":0,"max":360,"default":0},{"id":"dist","name":"Length","min":0,"max":300,"default":80},{"id":"threshold","name":"Threshold","min":0,"max":1,"default":0.6},{"id":"strength","name":"Strength","min":0,"max":2,"default":1}],"shader":"vec4 effect(vec2 uv) { float a = radians(angle); vec2 d = vec2(cos(a), sin(a)) * dist / resolution; vec4 c = texture2D(image, uv); vec3 m = vec3(0.0); for (int i = -6; i <= 6; i++) { vec3 s = texture2D(image, uv + d * float(i) / 6.0).rgb; float w = 1.0 - abs(float(i)) / 7.0; m = max(m, max(s - vec3(threshold), vec3(0.0)) * w); } return vec4(c.rgb + m * strength, c.a); }"}
