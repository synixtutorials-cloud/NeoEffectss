{"neofx":2,"id":"saturation_vibrance","name":"Saturation / Vibrance","category":"Color","params":[{"id":"saturation","name":"Saturation","min":-1,"max":1,"default":0.2},{"id":"vibrance","name":"Vibrance","min":-1,"max":1,"default":0.4}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); vec3 c = s.rgb; float g = lum(c); float spread = max(c.r, max(c.g, c.b)) - min(c.r, min(c.g, c.b)); c = mix(vec3(g), c, 1.0 + saturation + vibrance * (1.0 - spread)); return vec4(clamp(c, 0.0, 1.0), s.a); }"}
