{"neofx":2,"id":"light_glow","name":"Light Glow","category":"Light","params":[{"id":"radius","name":"Radius","min":1,"max":100,"default":30},{"id":"intensity","name":"Intensity","min":0,"max":3,"default":1.2},{"id":"threshold","name":"Threshold","min":0,"max":1,"default":0.6}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec2 px = radius / resolution; vec3 g = vec3(0.0); for (int i = 0; i < 8; i++) { float a = float(i) * 0.785398; vec2 d = vec2(cos(a), sin(a)); g += max(texture2D(image, uv + d * px * 0.4).rgb - vec3(threshold), vec3(0.0)); g += max(texture2D(image, uv + d * px * 0.7).rgb - vec3(threshold), vec3(0.0)); g += max(texture2D(image, uv + d * px).rgb - vec3(threshold), vec3(0.0)); } g /= 24.0; return vec4(c.rgb + g * intensity * 3.0, c.a); }"}
