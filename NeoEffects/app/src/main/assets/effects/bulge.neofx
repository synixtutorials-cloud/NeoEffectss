{"neofx":2,"id":"bulge","name":"Bulge","category":"Distort","params":[{"id":"amount","name":"Amount","min":-1,"max":1,"default":0.6},{"id":"radius","name":"Radius","min":0.1,"max":1,"default":0.5},{"id":"cx","name":"Center X","min":0,"max":1,"default":0.5},{"id":"cy","name":"Center Y","min":0,"max":1,"default":0.5}],"shader":"vec4 effect(vec2 uv) { float asp = resolution.x / resolution.y; vec2 d = (uv - vec2(cx, cy)) * vec2(asp, 1.0); float r = length(d) / radius; if (r < 1.0) { d *= 1.0 - amount * (1.0 - r * r); } d /= vec2(asp, 1.0); return texture2D(image, vec2(cx, cy) + d); }"}
