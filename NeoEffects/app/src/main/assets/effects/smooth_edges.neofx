{"neofx":2,"id":"smooth_edges","name":"Smooth Edges","category":"Stylize","params":[{"id":"radius","name":"Radius","min":0.5,"max":6,"default":1.5}],"shader":"vec4 effect(vec2 uv) { vec2 px = radius / resolution; vec4 c = texture2D(image, uv); vec4 b = (c * 2.0 + texture2D(image, uv + vec2(px.x, 0.0)) + texture2D(image, uv - vec2(px.x, 0.0)) + texture2D(image, uv + vec2(0.0, px.y)) + texture2D(image, uv - vec2(0.0, px.y))) / 6.0; float e = clamp(abs(b.a - c.a) * 4.0, 0.0, 1.0); return mix(c, b, e); }"}
