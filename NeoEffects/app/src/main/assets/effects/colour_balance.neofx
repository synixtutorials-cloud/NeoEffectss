{"neofx":2,"id":"colour_balance","name":"Colour Balance","category":"Color","params":[{"id":"sr","name":"Shadows R","min":-1,"max":1,"default":0},{"id":"sg","name":"Shadows G","min":-1,"max":1,"default":0},{"id":"sb","name":"Shadows B","min":-1,"max":1,"default":0},{"id":"mr","name":"Mids R","min":-1,"max":1,"default":0},{"id":"mg","name":"Mids G","min":-1,"max":1,"default":0},{"id":"mb","name":"Mids B","min":-1,"max":1,"default":0},{"id":"hr","name":"Highs R","min":-1,"max":1,"default":0},{"id":"hg","name":"Highs G","min":-1,"max":1,"default":0},{"id":"hb","name":"Highs B","min":-1,"max":1,"default":0}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); float l = lum(s.rgb); float ws = (1.0 - l) * (1.0 - l); float wm = 4.0 * l * (1.0 - l); float wh = l * l; vec3 c = s.rgb + vec3(sr, sg, sb) * 0.25 * ws + vec3(mr, mg, mb) * 0.25 * wm + vec3(hr, hg, hb) * 0.25 * wh; return vec4(clamp(c, 0.0, 1.0), s.a); }"}
