{"neofx":2,"id":"hot_colour","name":"Hot Colour","category":"Color","params":[{"id":"amount","name":"Amount","min":0,"max":1,"default":1}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); float l = lum(s.rgb); vec3 h = vec3(clamp(l * 3.0, 0.0, 1.0), clamp(l * 3.0 - 1.0, 0.0, 1.0), clamp(l * 3.0 - 2.0, 0.0, 1.0)); return vec4(mix(s.rgb, h, amount), s.a); }"}
