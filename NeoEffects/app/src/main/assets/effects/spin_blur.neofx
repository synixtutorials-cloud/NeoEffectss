{"neofx":2,"id":"spin_blur","name":"Spin Blur","category":"Blur","params":[{"id":"amount","name":"Amount","min":0,"max":1.5,"default":0.2}],"shader":"vec4 effect(vec2 uv) { vec2 p = uv - vec2(0.5, 0.5); vec4 s = vec4(0.0); for (int i = 0; i < 9; i++) { float a = (float(i) / 8.0 - 0.5) * amount; float cs = cos(a); float sn = sin(a); vec2 q = vec2(p.x * cs - p.y * sn, p.x * sn + p.y * cs); s += texture2D(image, q + vec2(0.5, 0.5)); } return s / 9.0; }"}
