{"neofx":2,"id":"threshold","name":"Threshold","category":"Color","params":[{"id":"level","name":"Level","min":0,"max":1,"default":0.5},{"id":"soft","name":"Softness","min":0,"max":0.3,"default":0.02}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); float t = smoothstep(level - soft, level + soft + 0.0001, lum(s.rgb)); return vec4(vec3(t), s.a); }"}
