{"neofx":2,"id":"colour_temperature","name":"Colour Temperature","category":"Color","params":[{"id":"temp","name":"Temperature","min":-1,"max":1,"default":0.3}],"shader":"vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); vec3 c = s.rgb + vec3(temp * 0.15, temp * 0.03, -temp * 0.15); return vec4(clamp(c, 0.0, 1.0), s.a); }"}
