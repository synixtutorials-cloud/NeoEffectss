{"neofx":2,"id":"cmyk_halftone","name":"CMYK Halftone","category":"Stylize","params":[{"id":"dots","name":"Dot size","min":4,"max":40,"default":10},{"id":"amount","name":"Amount","min":0,"max":1,"default":1}],"shader":"float ht(vec2 p, float ang, float cs, float v) { float a = radians(ang); mat2 r = mat2(cos(a), -sin(a), sin(a), cos(a)); vec2 q = r * p / cs; vec2 f = fract(q) - vec2(0.5, 0.5); float rad = sqrt(v) * 0.7; return 1.0 - smoothstep(rad - 0.08, rad, length(f)); } vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); vec3 c = s.rgb; float k = 1.0 - max(c.r, max(c.g, c.b)); vec3 cmy = (vec3(1.0) - c - vec3(k)) / max(1.0 - k, 0.001); vec2 p = uv * resolution; float hc = ht(p, 15.0, dots, cmy.r); float hm = ht(p, 75.0, dots, cmy.g); float hy = ht(p, 0.0, dots, cmy.b); float hk = ht(p, 45.0, dots, k); vec3 o = vec3(1.0) - vec3(hc, hm, hy); o *= (1.0 - hk); return vec4(mix(c, o, amount), s.a); }"}
