{"neofx":2,"id":"heart_mask","name":"Heart Mask","category":"Key","params":[{"id":"size","name":"Size","min":0.2,"max":1.5,"default":0.8},{"id":"feather","name":"Feather","min":0,"max":0.3,"default":0.03}],"shader":"vec4 effect(vec2 uv) { float asp = resolution.x / resolution.y; vec2 p = (uv - vec2(0.5, 0.5)) * vec2(asp, -1.0) * 2.4 / size; float x = p.x; float y = p.y + 0.25; float v = pow(x * x + y * y - 1.0, 3.0) - x * x * y * y * y; float m = 1.0 - smoothstep(-feather, feather + 0.0001, v); return texture2D(image, uv) * m; }"}
