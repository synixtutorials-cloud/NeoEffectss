{"neofx":2,"id":"directional_blur","name":"Directional Blur","category":"Blur","params":[{"id":"angle","name":"Angle","min":0,"max":360,"default":0},{"id":"dist","name":"Length","min":0,"max":160,"default":24}],"shader":"vec4 effect(vec2 uv) { float a = radians(angle); vec2 d = vec2(cos(a), sin(a)) * dist / resolution; vec4 s = vec4(0.0); for (int i = 0; i < 9; i++) { float t = float(i) / 8.0 - 0.5; s += texture2D(image, uv + d * t); } return s / 9.0; }"}
