{"neofx":2,"id":"lens_blur","name":"Lens Blur","category":"Blur","params":[{"id":"radius","name":"Radius","min":0,"max":50,"default":14}],"shader":"vec4 effect(vec2 uv) { vec4 s = vec4(0.0); for (int i = 0; i < 16; i++) { float a = float(i) * 2.39996; float r = sqrt((float(i) + 0.5) / 16.0); s += texture2D(image, uv + vec2(cos(a), sin(a)) * r * radius / resolution); } return s / 16.0; }"}
