{"neofx":2,"id":"wave_warp","name":"Wave Warp","category":"Distort","params":[{"id":"amount","name":"Amount","min":0,"max":80,"default":14},{"id":"wavelength","name":"Wavelength","min":5,"max":300,"default":50},{"id":"rate","name":"Speed","min":0,"max":10,"default":2},{"id":"angle","name":"Angle","min":0,"max":360,"default":0}],"shader":"vec4 effect(vec2 uv) { float a = radians(angle); vec2 dir = vec2(cos(a), sin(a)); vec2 nrm = vec2(-dir.y, dir.x); float p = dot(uv * resolution, dir) / wavelength; vec2 off = nrm * sin(p * 6.2831853 + time * rate) * amount / resolution; return texture2D(image, uv + off); }"}
