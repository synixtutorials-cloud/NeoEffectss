{"neofx":2,"id":"radial_wipe","name":"Radial Wipe","category":"Transition","params":[{"id":"dur","name":"Duration (s)","min":0.1,"max":5,"default":1},{"id":"soft","name":"Softness","min":0.001,"max":0.3,"default":0.05},{"id":"start","name":"Start angle","min":0,"max":360,"default":0}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float p = clamp(ctime / dur, 0.0, 1.0); vec2 d = uv - vec2(0.5, 0.5); float a = atan(d.y, d.x + 0.00001) + 3.14159 - radians(start); a = mod(a, 6.2831853) / 6.2831853; float m = 1.0 - smoothstep(p * (1.0 + soft) - soft, p * (1.0 + soft) + 0.0001, a); return c * m; }"}
