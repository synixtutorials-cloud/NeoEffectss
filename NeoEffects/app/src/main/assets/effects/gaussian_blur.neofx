{"neofx":2,"id":"gaussian_blur","name":"Gaussian Blur","category":"Blur","params":[{"id":"radius","name":"Radius","min":0,"max":40,"default":10}],"shader":"vec4 effect(vec2 uv) { vec2 px = radius * 0.5 / resolution; vec4 s = vec4(0.0); float t = 0.0; for (int i = -2; i <= 2; i++) { for (int j = -2; j <= 2; j++) { float w = exp(-float(i * i + j * j) * 0.4); s += texture2D(image, uv + vec2(float(i), float(j)) * px) * w; t += w; } } return s / t; }"}
