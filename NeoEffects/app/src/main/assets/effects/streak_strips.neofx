{"neofx":2,"id":"streak_strips","name":"Streak Strips","category":"Blur","params":[{"id":"strips","name":"Strips","min":4,"max":60,"default":16},{"id":"shiftv","name":"Shift","min":0,"max":0.3,"default":0.06},{"id":"rate","name":"Speed","min":0,"max":12,"default":4}],"shader":"float rnd1(float x) { return fract(sin(x * 91.345) * 47453.5453); } vec4 effect(vec2 uv) { float s = floor(uv.x * strips); float o = (rnd1(s + floor(time * rate)) - 0.5) * shiftv; return texture2D(image, vec2(uv.x, uv.y + o)); }"}
