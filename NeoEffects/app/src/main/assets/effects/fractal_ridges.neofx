{"neofx":2,"id":"fractal_ridges","name":"Fractal Ridges","category":"Stylize","params":[{"id":"scale","name":"Scale","min":1,"max":20,"default":6},{"id":"amount","name":"Amount","min":0,"max":1,"default":0.5},{"id":"hue","name":"Hue","min":0,"max":1,"default":0.6}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } float vn(vec2 p) { vec2 i = floor(p); vec2 f = fract(p); f = f * f * (3.0 - 2.0 * f); float a = rnd(i); float b = rnd(i + vec2(1.0, 0.0)); float c = rnd(i + vec2(0.0, 1.0)); float d = rnd(i + vec2(1.0, 1.0)); return mix(mix(a, b, f.x), mix(c, d, f.x), f.y); } vec3 rgb2hsv(vec3 c) { vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0); vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g)); vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r)); float d = q.x - min(q.w, q.y); float e = 1.0e-10; return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x); } vec3 hsv2rgb(vec3 c) { vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0); vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www); return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float n = 0.0; float a = 0.5; vec2 p = uv * scale + vec2(time * 0.1, 0.0); for (int i = 0; i < 4; i++) { n += a * (1.0 - abs(vn(p) * 2.0 - 1.0)); p *= 2.0; a *= 0.5; } vec3 col = hsv2rgb(vec3(hue, 0.7, 1.0)) * n * n; return vec4(c.rgb + col * amount, c.a); }"}
