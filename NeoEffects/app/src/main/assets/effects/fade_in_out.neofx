{"neofx":2,"id":"fade_in_out","name":"Fade In / Out","category":"Animate","params":[{"id":"fadein","name":"Fade in (s)","min":0,"max":5,"default":0.5},{"id":"fadeout","name":"Fade out (s)","min":0,"max":5,"default":0.5}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float a = min(clamp(ctime / max(fadein, 0.001), 0.0, 1.0), clamp((cdur - ctime) / max(fadeout, 0.001), 0.0, 1.0)); return c * a; }"}
