{"neofx":2,"id":"box_blur","name":"Box Blur","category":"Blur","params":[{"id":"radius","name":"Radius","min":0,"max":40,"default":8}],"shader":"vec4 effect(vec2 uv) { vec2 px = radius * 0.5 / resolution; vec4 s = vec4(0.0); for (int i = -2; i <= 2; i++) { for (int j = -2; j <= 2; j++) { s += texture2D(image, uv + vec2(float(i), float(j)) * px); } } return s / 25.0; }"}
