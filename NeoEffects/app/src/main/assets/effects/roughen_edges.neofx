{"neofx":2,"id":"roughen_edges","name":"Roughen Edges","category":"Stylize","params":[{"id":"amount","name":"Amount","min":0,"max":60,"default":10},{"id":"scale","name":"Scale","min":2,"max":60,"default":18}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } float vn(vec2 p) { vec2 i = floor(p); vec2 f = fract(p); f = f * f * (3.0 - 2.0 * f); float a = rnd(i); float b = rnd(i + vec2(1.0, 0.0)); float c = rnd(i + vec2(0.0, 1.0)); float d = rnd(i + vec2(1.0, 1.0)); return mix(mix(a, b, f.x), mix(c, d, f.x), f.y); } vec4 effect(vec2 uv) { vec2 d = vec2(vn(uv * scale) - 0.5, vn(uv * scale + vec2(7.3, 3.1)) - 0.5) * amount / resolution; return texture2D(image, uv + d); }"}
