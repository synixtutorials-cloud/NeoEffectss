{"neofx":2,"id":"palette_map","name":"Palette Map","category":"Color","params":[{"id":"base","name":"Base hue","min":0,"max":1,"default":0.6},{"id":"spread","name":"Spread","min":0,"max":1,"default":0.3},{"id":"levels","name":"Colours","min":2,"max":8,"default":5},{"id":"amount","name":"Amount","min":0,"max":1,"default":1}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec3 rgb2hsv(vec3 c) { vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0); vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g)); vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r)); float d = q.x - min(q.w, q.y); float e = 1.0e-10; return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x); } vec3 hsv2rgb(vec3 c) { vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0); vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www); return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y); } vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); float l = lum(s.rgb); float n = max(levels, 2.0); float q = floor(l * (n - 0.001)) / (n - 1.0); vec3 pc = hsv2rgb(vec3(fract(base + q * spread), 0.75, 0.25 + 0.75 * q)); return vec4(mix(s.rgb, pc, amount), s.a); }"}
