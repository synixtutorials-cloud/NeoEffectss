{"neofx":2,"id":"tunnel","name":"Tunnel","category":"Distort","params":[{"id":"depth","name":"Depth","min":0.1,"max":3,"default":0.6},{"id":"twist","name":"Twist","min":0,"max":3,"default":0.5},{"id":"rate","name":"Speed","min":0,"max":5,"default":1}],"shader":"vec4 effect(vec2 uv) { vec2 p = uv - vec2(0.5, 0.5); float r = length(p) + 0.0001; float a = atan(p.y, p.x + 0.00001); vec2 q = vec2(depth / r + time * rate * 0.2, a / 3.14159 + twist * r); return texture2D(image, fract(q)) * smoothstep(0.0, 0.15, r); }"}
