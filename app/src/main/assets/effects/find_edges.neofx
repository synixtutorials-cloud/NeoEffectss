{"neofx":2,"id":"find_edges","name":"Find Edges","category":"Stylize","params":[{"id":"strength","name":"Strength","min":0,"max":8,"default":3},{"id":"invertamt","name":"Invert","min":0,"max":1,"default":0}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec4 effect(vec2 uv) { vec2 px = 1.0 / resolution; float gx = lum(texture2D(image, uv + vec2(px.x, 0.0)).rgb) - lum(texture2D(image, uv - vec2(px.x, 0.0)).rgb); float gy = lum(texture2D(image, uv + vec2(0.0, px.y)).rgb) - lum(texture2D(image, uv - vec2(0.0, px.y)).rgb); float e = clamp(length(vec2(gx, gy)) * strength, 0.0, 1.0); vec3 o = mix(vec3(1.0 - e), vec3(e), invertamt); return vec4(o, texture2D(image, uv).a); }"}
