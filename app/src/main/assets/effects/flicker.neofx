{"neofx":2,"id":"flicker","name":"Flicker","category":"Animate","params":[{"id":"amount","name":"Amount","min":0,"max":1,"default":0.4},{"id":"rate","name":"Rate","min":1,"max":60,"default":18}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float k = 1.0 - amount * rnd(vec2(floor(time * rate), 3.0)); return c * k; }"}
