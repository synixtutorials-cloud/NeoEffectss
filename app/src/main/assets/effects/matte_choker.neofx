{"neofx":2,"id":"matte_choker","name":"Matte Choker","category":"Key","params":[{"id":"choke","name":"Choke / spread","min":-4,"max":4,"default":1.5}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float m = c.a; vec2 px = abs(choke) / resolution; for (int i = 0; i < 8; i++) { float a = float(i) * 0.785398; float s = texture2D(image, uv + vec2(cos(a), sin(a)) * px).a; m = choke > 0.0 ? min(m, s) : max(m, s); } return vec4(c.rgb * min(1.0, m / max(c.a, 0.001)), m); }"}
