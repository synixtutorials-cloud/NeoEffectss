{"neofx":2,"id":"cylinder_warp","name":"Cylinder Warp","category":"Distort","params":[{"id":"amount","name":"Amount","min":0,"max":1,"default":0.8}],"shader":"vec4 effect(vec2 uv) { float x = (uv.x - 0.5) * 2.0; float k = asin(clamp(x, -1.0, 1.0)) / 1.5708; return texture2D(image, vec2(mix(uv.x, k * 0.5 + 0.5, amount), uv.y)); }"}
