{"neofx":2,"id":"venetian_blinds","name":"Venetian Blinds","category":"Distort","params":[{"id":"count","name":"Blinds","min":2,"max":60,"default":12},{"id":"opening","name":"Opening","min":0,"max":1,"default":0.5},{"id":"angle","name":"Angle","min":0,"max":360,"default":0}],"shader":"vec4 effect(vec2 uv) { float a = radians(angle); float p = dot(uv, vec2(cos(a), sin(a))) * count; float m = step(fract(p), opening); return texture2D(image, uv) * m; }"}
