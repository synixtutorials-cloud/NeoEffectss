{"neofx":2,"id":"blink","name":"Blink","category":"Animate","params":[{"id":"rate","name":"Rate","min":0.5,"max":20,"default":4},{"id":"duty","name":"On time","min":0,"max":1,"default":0.5}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); return c * step(fract(ctime * rate), duty); }"}
