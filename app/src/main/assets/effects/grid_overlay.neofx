{"neofx":2,"id":"grid_overlay","name":"Grid","category":"Stylize","params":[{"id":"tile","name":"Cell size","min":10,"max":300,"default":60},{"id":"width","name":"Line width","min":1,"max":10,"default":2},{"id":"opacity","name":"Opacity","min":0,"max":1,"default":0.5}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec2 p = mod(uv * resolution, tile); float l = step(p.x, width) + step(p.y, width); return vec4(mix(c.rgb, vec3(1.0), clamp(l, 0.0, 1.0) * opacity), c.a); }"}
