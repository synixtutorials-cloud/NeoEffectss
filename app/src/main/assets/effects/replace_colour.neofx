{"neofx":2,"id":"replace_colour","name":"Replace Colour","category":"Color","params":[{"id":"fromh","name":"From hue","min":0,"max":1,"default":0.0},{"id":"toh","name":"To hue","min":0,"max":1,"default":0.6},{"id":"tol","name":"Tolerance","min":0.01,"max":0.5,"default":0.08},{"id":"soft","name":"Softness","min":0,"max":0.5,"default":0.05}],"shader":"vec3 rgb2hsv(vec3 c) { vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0); vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g)); vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r)); float d = q.x - min(q.w, q.y); float e = 1.0e-10; return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x); } vec3 hsv2rgb(vec3 c) { vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0); vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www); return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y); } vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); vec3 h = rgb2hsv(s.rgb); float d = abs(h.x - fromh); d = min(d, 1.0 - d); float m = 1.0 - smoothstep(tol, tol + soft + 0.001, d); h.x = mix(h.x, toh, m); return vec4(hsv2rgb(h), s.a); }"}
