{"neofx":2,"id":"brightness_contrast","name":"Brightness / Contrast","category":"Color","params":[{"id":"brightness","name":"Brightness","min":-1,"max":1,"default":0},{"id":"contrast","name":"Contrast","min":-1,"max":1,"default":0.2}],"shader":"vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); vec3 c = (s.rgb + vec3(brightness) - vec3(0.5)) * (1.0 + contrast) + vec3(0.5); return vec4(clamp(c, 0.0, 1.0), s.a); }"}
