{"neofx":2,"id":"halftone_lines","name":"Halftone Lines","category":"Stylize","params":[{"id":"spacing","name":"Spacing","min":3,"max":40,"default":8},{"id":"angle","name":"Angle","min":0,"max":180,"default":45},{"id":"amount","name":"Amount","min":0,"max":1,"default":1}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); float a = radians(angle); float p = dot(uv * resolution, vec2(cos(a), sin(a))); float f = fract(p / spacing) - 0.5; float w = (1.0 - lum(s.rgb)) * 0.5; float m = 1.0 - smoothstep(w - 0.05, w + 0.001, abs(f)); return vec4(mix(s.rgb, vec3(1.0 - m), amount), s.a); }"}
