{"neofx":2,"id":"gradient_map","name":"Gradient Map","category":"Color","params":[{"id":"h1","name":"Shadow hue","min":0,"max":1,"default":0.65},{"id":"h2","name":"Mid hue","min":0,"max":1,"default":0.9},{"id":"h3","name":"Light hue","min":0,"max":1,"default":0.12},{"id":"amount","name":"Amount","min":0,"max":1,"default":1}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec3 rgb2hsv(vec3 c) { vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0); vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g)); vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r)); float d = q.x - min(q.w, q.y); float e = 1.0e-10; return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x); } vec3 hsv2rgb(vec3 c) { vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0); vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www); return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y); } vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); float l = lum(s.rgb); vec3 a = hsv2rgb(vec3(h1, 0.8, 0.15)); vec3 b = hsv2rgb(vec3(h2, 0.8, 0.6)); vec3 c = hsv2rgb(vec3(h3, 0.6, 1.0)); vec3 g = l < 0.5 ? mix(a, b, l * 2.0) : mix(b, c, (l - 0.5) * 2.0); return vec4(mix(s.rgb, g, amount), s.a); }"}
