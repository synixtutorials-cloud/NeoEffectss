{"neofx":2,"id":"unsharp_mask","name":"Unsharp Mask","category":"Detail","params":[{"id":"radius","name":"Radius","min":0.5,"max":10,"default":2},{"id":"amount","name":"Amount","min":0,"max":4,"default":1.2},{"id":"threshold","name":"Threshold","min":0,"max":0.3,"default":0.02}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec2 px = radius / resolution; vec3 b = c.rgb; for (int i = 0; i < 8; i++) { float a = float(i) * 0.785398; b += texture2D(image, uv + vec2(cos(a), sin(a)) * px).rgb; } b /= 9.0; vec3 d = c.rgb - b; float k = step(threshold, length(d)); return vec4(clamp(c.rgb + d * amount * k, 0.0, 1.0), c.a); }"}
