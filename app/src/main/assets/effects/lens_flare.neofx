{"neofx":2,"id":"lens_flare","name":"Lens Flare","category":"Light","params":[{"id":"lx","name":"Position X","min":0,"max":1,"default":0.7},{"id":"ly","name":"Position Y","min":0,"max":1,"default":0.3},{"id":"intensity","name":"Intensity","min":0,"max":2,"default":1}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec2 p = vec2(lx, ly); float asp = resolution.x / resolution.y; vec2 d = (uv - p) * vec2(asp, 1.0); float r = length(d); float core = 0.04 / (r + 0.04); float streak = exp(-abs(d.y) * 40.0) * exp(-abs(d.x) * 2.0) * 0.5; vec2 m = vec2(0.5, 0.5) - p; float ring = 0.0; for (int i = 1; i <= 3; i++) { vec2 q = p + m * float(i) * 0.5; float rr = length((uv - q) * vec2(asp, 1.0)); ring += exp(-pow((rr - 0.05 * float(i)) / 0.02, 2.0)) * 0.15; } vec3 col = vec3(1.0, 0.85, 0.6) * (core + streak) + vec3(0.6, 0.8, 1.0) * ring; return vec4(c.rgb + col * intensity, c.a); }"}
