{"neofx":2,"id":"pulse_opacity","name":"Pulse Opacity","category":"Animate","params":[{"id":"rate","name":"Rate","min":0.1,"max":10,"default":2},{"id":"depth","name":"Depth","min":0,"max":1,"default":0.5}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float k = 1.0 - depth * (0.5 + 0.5 * sin(ctime * rate * 6.2831853)); return c * k; }"}
