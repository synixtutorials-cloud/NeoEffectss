{"neofx":2,"id":"ripple","name":"Ripple","category":"Distort","params":[{"id":"amount","name":"Amount","min":0,"max":40,"default":10},{"id":"freq","name":"Frequency","min":1,"max":80,"default":24},{"id":"rate","name":"Speed","min":0,"max":10,"default":3},{"id":"cx","name":"Center X","min":0,"max":1,"default":0.5},{"id":"cy","name":"Center Y","min":0,"max":1,"default":0.5}],"shader":"vec4 effect(vec2 uv) { vec2 c0 = vec2(cx, cy); float r = distance(uv, c0); vec2 d = normalize(uv - c0 + vec2(0.00001, 0.00001)) * sin(r * freq - time * rate) * amount / resolution; return texture2D(image, uv + d); }"}
