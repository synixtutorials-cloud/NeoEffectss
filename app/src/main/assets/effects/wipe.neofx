{"neofx":2,"id":"wipe","name":"Wipe","category":"Transition","params":[{"id":"dur","name":"Duration (s)","min":0.1,"max":5,"default":1},{"id":"soft","name":"Softness","min":0.001,"max":0.5,"default":0.05},{"id":"angle","name":"Angle","min":0,"max":360,"default":0}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float p = clamp(ctime / dur, 0.0, 1.0); float a = radians(angle); float t = dot(uv - vec2(0.5, 0.5), vec2(cos(a), sin(a))) + 0.5; float m = 1.0 - smoothstep(p * (1.0 + soft) - soft, p * (1.0 + soft) + 0.0001, t); return c * m; }"}
