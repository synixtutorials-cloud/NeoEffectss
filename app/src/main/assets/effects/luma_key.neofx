{"neofx":2,"id":"luma_key","name":"Luma Key","category":"Key","params":[{"id":"level","name":"Level","min":0,"max":1,"default":0.5},{"id":"soft","name":"Softness","min":0,"max":0.5,"default":0.1},{"id":"invertk","name":"Invert","min":0,"max":1,"default":0}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); float a = smoothstep(level - soft, level + soft + 0.001, lum(s.rgb)); a = mix(a, 1.0 - a, invertk); return vec4(s.rgb * a, s.a * a); }"}
