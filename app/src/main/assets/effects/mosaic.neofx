{"neofx":2,"id":"mosaic","name":"Mosaic","category":"Stylize","params":[{"id":"tile","name":"Tile size","min":4,"max":100,"default":18},{"id":"gap","name":"Grout","min":0,"max":0.5,"default":0.1}],"shader":"vec4 effect(vec2 uv) { vec2 p = uv * resolution; vec2 cell = floor(p / tile); vec2 f = fract(p / tile); vec4 c = texture2D(image, (cell * tile + vec2(tile * 0.5)) / resolution); float g = step(gap, f.x) * step(gap, f.y); return vec4(c.rgb * mix(0.55, 1.0, g), c.a); }"}
