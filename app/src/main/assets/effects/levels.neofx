{"neofx":2,"id":"levels","name":"Levels","category":"Color","params":[{"id":"inblack","name":"Input black","min":0,"max":1,"default":0},{"id":"inwhite","name":"Input white","min":0,"max":1,"default":1},{"id":"gamma","name":"Gamma","min":0.2,"max":3,"default":1},{"id":"outblack","name":"Output black","min":0,"max":1,"default":0},{"id":"outwhite","name":"Output white","min":0,"max":1,"default":1}],"shader":"vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); vec3 c = clamp((s.rgb - vec3(inblack)) / max(inwhite - inblack, 0.001), 0.0, 1.0); c = pow(c, vec3(1.0 / gamma)); c = mix(vec3(outblack), vec3(outwhite), c); return vec4(c, s.a); }"}
