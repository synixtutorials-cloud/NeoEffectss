{"neofx":2,"id":"spherize","name":"Spherize","category":"Distort","params":[{"id":"amount","name":"Amount","min":-1,"max":1,"default":0.8},{"id":"radius","name":"Radius","min":0.2,"max":1,"default":0.5}],"shader":"vec4 effect(vec2 uv) { float asp = resolution.x / resolution.y; vec2 d = (uv - vec2(0.5, 0.5)) * vec2(asp, 1.0); float nr = length(d) / radius; if (nr < 1.0) { float f = (1.0 - sqrt(1.0 - nr * nr)) / max(nr, 0.0001); d *= mix(1.0, f, amount); } d /= vec2(asp, 1.0); return texture2D(image, vec2(0.5, 0.5) + d); }"}
