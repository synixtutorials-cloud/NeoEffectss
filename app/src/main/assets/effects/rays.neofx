{"neofx":2,"id":"rays","name":"Rays","category":"Light","params":[{"id":"strength","name":"Strength","min":0,"max":2,"default":0.8},{"id":"len","name":"Length","min":0.1,"max":1,"default":0.5},{"id":"threshold","name":"Threshold","min":0,"max":1,"default":0.5},{"id":"ox","name":"Origin X","min":0,"max":1,"default":0.5},{"id":"oy","name":"Origin Y","min":0,"max":1,"default":0.3}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec2 d = (vec2(ox, oy) - uv) * len / 14.0; vec2 p = uv; vec3 s = vec3(0.0); float w = 1.0; for (int i = 0; i < 14; i++) { p += d; s += max(texture2D(image, p).rgb - vec3(threshold), vec3(0.0)) * w; w *= 0.93; } return vec4(c.rgb + s * strength / 6.0, c.a); }"}
