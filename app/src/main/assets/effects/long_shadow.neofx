{"neofx":2,"id":"long_shadow","name":"Long Shadow","category":"Light","params":[{"id":"angle","name":"Angle","min":0,"max":360,"default":45},{"id":"dist","name":"Length","min":0,"max":0.5,"default":0.2},{"id":"opacity","name":"Opacity","min":0,"max":1,"default":0.6}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float a = radians(angle); vec2 d = vec2(cos(a), sin(a)) * dist; float sh = 0.0; for (int i = 1; i <= 12; i++) { vec3 s = texture2D(image, uv - d * float(i) / 12.0).rgb; sh = max(sh, lum(s)); } float m = sh * (1.0 - lum(c.rgb)); return vec4(c.rgb * (1.0 - m * opacity), c.a); }"}
