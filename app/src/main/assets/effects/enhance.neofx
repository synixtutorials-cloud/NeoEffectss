{"neofx":2,"id":"enhance","name":"Enhance","category":"Detail","params":[{"id":"sharpen","name":"Sharpen","min":0,"max":2,"default":0.9},{"id":"denoise","name":"Denoise","min":0,"max":1,"default":0.4},{"id":"saturation","name":"Saturation","min":0.5,"max":1.5,"default":1.1},{"id":"contrast","name":"Contrast","min":0.8,"max":1.3,"default":1.04},{"id":"hdr","name":"HDR fix","min":0,"max":1,"default":0.4}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec4 effect(vec2 uv) { vec2 px = 1.0 / resolution; vec4 s = texture2D(image, uv); vec3 c = s.rgb; vec3 n = texture2D(image, uv + vec2(px.x, 0.0)).rgb + texture2D(image, uv - vec2(px.x, 0.0)).rgb + texture2D(image, uv + vec2(0.0, px.y)).rgb + texture2D(image, uv - vec2(0.0, px.y)).rgb; vec3 bl = (n + c) / 5.0; float edge = length(c - bl); c = mix(c, bl, denoise * (1.0 - clamp(edge * 8.0, 0.0, 1.0))); c += sharpen * (s.rgb - bl); float l = lum(c); c += hdr * (0.18 * (1.0 - l) * (1.0 - l) - 0.08 * l * l); float g = lum(c); c = mix(vec3(g), c, saturation); c = (c - vec3(0.5)) * contrast + vec3(0.5); return vec4(clamp(c, 0.0, 1.0), s.a); }"}
