{"neofx":2,"id":"tiles","name":"Tiles","category":"Distort","params":[{"id":"count","name":"Tiles","min":1,"max":10,"default":2},{"id":"mirrorm","name":"Mirror","min":0,"max":1,"default":0}],"shader":"vec4 effect(vec2 uv) { vec2 p = uv * count; vec2 f = fract(p); if (mirrorm > 0.5) { vec2 i = floor(p); f = mix(f, vec2(1.0) - f, mod(i, 2.0)); } return texture2D(image, f); }"}
