{"neofx":2,"id":"turbulent_displace","name":"Turbulent Displace","category":"Distort","params":[{"id":"amount","name":"Amount","min":0,"max":80,"default":16},{"id":"size","name":"Size","min":1,"max":30,"default":6},{"id":"rate","name":"Speed","min":0,"max":5,"default":1}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } float vn(vec2 p) { vec2 i = floor(p); vec2 f = fract(p); f = f * f * (3.0 - 2.0 * f); float a = rnd(i); float b = rnd(i + vec2(1.0, 0.0)); float c = rnd(i + vec2(0.0, 1.0)); float d = rnd(i + vec2(1.0, 1.0)); return mix(mix(a, b, f.x), mix(c, d, f.x), f.y); } vec4 effect(vec2 uv) { vec2 p = uv * size + vec2(time * rate, time * rate * 0.7); vec2 d = vec2(vn(p) - 0.5, vn(p + vec2(5.2, 1.3)) - 0.5) * amount / resolution; return texture2D(image, uv + d); }"}
