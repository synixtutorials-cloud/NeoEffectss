{"neofx":2,"id":"key_spill_cleaner","name":"Key Spill Cleaner","category":"Key","params":[{"id":"keyhue","name":"Spill hue","min":0,"max":1,"default":0.33},{"id":"range","name":"Range","min":0.02,"max":0.5,"default":0.15},{"id":"amount","name":"Amount","min":0,"max":1,"default":1}],"shader":"vec3 rgb2hsv(vec3 c) { vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0); vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g)); vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r)); float d = q.x - min(q.w, q.y); float e = 1.0e-10; return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x); } vec3 hsv2rgb(vec3 c) { vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0); vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www); return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y); } vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); vec3 h = rgb2hsv(s.rgb); float d = abs(h.x - keyhue); d = min(d, 1.0 - d); float m = 1.0 - smoothstep(range * 0.5, range, d); h.y *= 1.0 - m * amount; h.x = mix(h.x, fract(keyhue + 0.5), m * amount * 0.3); return vec4(hsv2rgb(h), s.a); }"}
