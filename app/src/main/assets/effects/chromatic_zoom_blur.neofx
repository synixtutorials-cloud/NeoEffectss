{"neofx":2,"id":"chromatic_zoom_blur","name":"Chromatic Zoom Blur","category":"Blur","params":[{"id":"strength","name":"Strength","min":0,"max":1,"default":0.25}],"shader":"vec4 effect(vec2 uv) { vec2 d = uv - vec2(0.5, 0.5); vec3 s = vec3(0.0); for (int i = 0; i < 8; i++) { float t = float(i) / 7.0 * strength; s.r += texture2D(image, uv - d * t * 1.3).r; s.g += texture2D(image, uv - d * t).g; s.b += texture2D(image, uv - d * t * 0.7).b; } vec4 c = texture2D(image, uv); return vec4(s / 8.0, c.a); }"}
