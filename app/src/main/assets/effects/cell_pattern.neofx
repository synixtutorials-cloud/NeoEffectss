{"neofx":2,"id":"cell_pattern","name":"Cell Pattern","category":"Stylize","params":[{"id":"cells","name":"Cell count","min":2,"max":40,"default":10},{"id":"amount","name":"Amount","min":0,"max":1,"default":0.5}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec2 p = uv * cells; vec2 g = floor(p); vec2 f = fract(p); float md = 8.0; for (int j = -1; j <= 1; j++) { for (int i = -1; i <= 1; i++) { vec2 o = vec2(float(i), float(j)); vec2 r = o + vec2(rnd(g + o), rnd(g + o + vec2(7.7, 3.3))) - f; md = min(md, dot(r, r)); } } float v = sqrt(md); return vec4(mix(c.rgb, c.rgb * (0.4 + v), amount), c.a); }"}
