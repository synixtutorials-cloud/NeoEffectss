{"neofx":2,"id":"channel_mixer","name":"Channel Mixer","category":"Color","params":[{"id":"rr","name":"R from R","min":-2,"max":2,"default":1},{"id":"rg","name":"R from G","min":-2,"max":2,"default":0},{"id":"rb","name":"R from B","min":-2,"max":2,"default":0},{"id":"gr","name":"G from R","min":-2,"max":2,"default":0},{"id":"gg","name":"G from G","min":-2,"max":2,"default":1},{"id":"gb","name":"G from B","min":-2,"max":2,"default":0},{"id":"br","name":"B from R","min":-2,"max":2,"default":0},{"id":"bg","name":"B from G","min":-2,"max":2,"default":0},{"id":"bb","name":"B from B","min":-2,"max":2,"default":1}],"shader":"vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); vec3 c = s.rgb; return vec4(clamp(vec3(dot(c, vec3(rr, rg, rb)), dot(c, vec3(gr, gg, gb)), dot(c, vec3(br, bg, bb))), 0.0, 1.0), s.a); }"}
