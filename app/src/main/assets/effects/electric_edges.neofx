{"neofx":2,"id":"electric_edges","name":"Electric Edges","category":"Stylize","params":[{"id":"strength","name":"Strength","min":0,"max":8,"default":3},{"id":"hue","name":"Hue","min":0,"max":1,"default":0.55},{"id":"flick","name":"Flicker","min":0,"max":1,"default":0.5}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } vec3 rgb2hsv(vec3 c) { vec4 K = vec4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0); vec4 p = mix(vec4(c.bg, K.wz), vec4(c.gb, K.xy), step(c.b, c.g)); vec4 q = mix(vec4(p.xyw, c.r), vec4(c.r, p.yzx), step(p.x, c.r)); float d = q.x - min(q.w, q.y); float e = 1.0e-10; return vec3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x); } vec3 hsv2rgb(vec3 c) { vec4 K = vec4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0); vec3 p = abs(fract(c.xxx + K.xyz) * 6.0 - K.www); return c.z * mix(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y); } vec4 effect(vec2 uv) { vec2 px = 1.0 / resolution; float gx = lum(texture2D(image, uv + vec2(px.x, 0.0)).rgb) - lum(texture2D(image, uv - vec2(px.x, 0.0)).rgb); float gy = lum(texture2D(image, uv + vec2(0.0, px.y)).rgb) - lum(texture2D(image, uv - vec2(0.0, px.y)).rgb); float e = clamp(length(vec2(gx, gy)) * strength, 0.0, 1.0); float f = 1.0 - flick * 0.6 * rnd(vec2(floor(time * 18.0), 1.0)); vec4 c = texture2D(image, uv); return vec4(c.rgb * 0.25 + hsv2rgb(vec3(hue, 0.7, 1.0)) * e * f * 1.6, c.a); }"}
