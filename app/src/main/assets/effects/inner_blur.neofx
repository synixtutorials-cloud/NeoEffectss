{"neofx":2,"id":"inner_blur","name":"Inner Blur","category":"Blur","params":[{"id":"radius","name":"Radius","min":0,"max":40,"default":12},{"id":"inner","name":"Clear center","min":0,"max":1,"default":0.35}],"shader":"vec4 effect(vec2 uv) { float m = smoothstep(inner, 1.0, length((uv - vec2(0.5, 0.5)) * 1.6)); vec2 px = radius * m / resolution; vec4 s = texture2D(image, uv); float n = 1.0; for (int i = 0; i < 8; i++) { float a = float(i) * 0.785398; vec2 d = vec2(cos(a), sin(a)) * px; s += texture2D(image, uv + d) + texture2D(image, uv + d * 0.5); n += 2.0; } return s / n; }"}
