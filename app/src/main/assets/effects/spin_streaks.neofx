{"neofx":2,"id":"spin_streaks","name":"Spin Streaks","category":"Blur","params":[{"id":"amount","name":"Amount","min":0,"max":1.5,"default":0.4},{"id":"threshold","name":"Threshold","min":0,"max":1,"default":0.55},{"id":"strength","name":"Strength","min":0,"max":2,"default":1}],"shader":"vec4 effect(vec2 uv) { vec2 p = uv - vec2(0.5, 0.5); vec4 c = texture2D(image, uv); vec3 m = vec3(0.0); for (int i = 0; i < 10; i++) { float a = (float(i) / 9.0 - 0.5) * amount; float cs = cos(a); float sn = sin(a); vec2 q = vec2(p.x * cs - p.y * sn, p.x * sn + p.y * cs); vec3 s = texture2D(image, q + vec2(0.5, 0.5)).rgb; m = max(m, max(s - vec3(threshold), vec3(0.0))); } return vec4(c.rgb + m * strength, c.a); }"}
