{"neofx":2,"id":"highlights_shadows","name":"Highlights & Shadows","category":"Color","params":[{"id":"highlights","name":"Highlights","min":-1,"max":1,"default":-0.3},{"id":"shadows","name":"Shadows","min":-1,"max":1,"default":0.3}],"shader":"float lum(vec3 c) { return dot(c, vec3(0.299, 0.587, 0.114)); } vec4 effect(vec2 uv) { vec4 s = texture2D(image, uv); float l = lum(s.rgb); vec3 c = s.rgb + vec3(shadows * 0.3 * (1.0 - smoothstep(0.0, 0.5, l)) + highlights * 0.3 * smoothstep(0.5, 1.0, l)); return vec4(clamp(c, 0.0, 1.0), s.a); }"}
