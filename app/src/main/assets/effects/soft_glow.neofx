{"neofx":2,"id":"soft_glow","name":"Soft Glow","category":"Light","params":[{"id":"radius","name":"Radius","min":1,"max":60,"default":16},{"id":"intensity","name":"Intensity","min":0,"max":3,"default":0.9},{"id":"threshold","name":"Threshold","min":0,"max":1,"default":0.4}],"shader":"vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); vec2 px = radius / resolution; vec3 g = vec3(0.0); for (int i = 0; i < 12; i++) { float a = float(i) * 0.5236; vec2 d = vec2(cos(a), sin(a)); g += max(texture2D(image, uv + d * px).rgb - vec3(threshold), vec3(0.0)); g += max(texture2D(image, uv + d * px * 0.5).rgb - vec3(threshold), vec3(0.0)); } g /= 24.0; vec3 o = vec3(1.0) - (vec3(1.0) - c.rgb) * (vec3(1.0) - g * intensity * 3.0); return vec4(o, c.a); }"}
