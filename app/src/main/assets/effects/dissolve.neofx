{"neofx":2,"id":"dissolve","name":"Dissolve","category":"Animate","params":[{"id":"dur","name":"Duration (s)","min":0.1,"max":5,"default":1},{"id":"soft","name":"Softness","min":0,"max":0.5,"default":0.15},{"id":"reverse","name":"Dissolve in","min":0,"max":1,"default":0}],"shader":"float rnd(vec2 s) { return fract(sin(dot(s, vec2(12.9898, 78.233))) * 43758.5453); } float vn(vec2 p) { vec2 i = floor(p); vec2 f = fract(p); f = f * f * (3.0 - 2.0 * f); float a = rnd(i); float b = rnd(i + vec2(1.0, 0.0)); float c = rnd(i + vec2(0.0, 1.0)); float d = rnd(i + vec2(1.0, 1.0)); return mix(mix(a, b, f.x), mix(c, d, f.x), f.y); } vec4 effect(vec2 uv) { vec4 c = texture2D(image, uv); float p = clamp(ctime / dur, 0.0, 1.0); if (reverse > 0.5) { p = 1.0 - p; } float n = vn(uv * 12.0); float m = smoothstep(p * (1.0 + soft) - soft, p * (1.0 + soft), n); return c * m; }"}
